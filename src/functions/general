#!/usr/bin/env bash
#
# General functions used for installs and updates
#
###############################################################################

# color output: only when TERM names a usable terminal (it is unset in
# non-interactive shells such as ssh host 'dot ...'), otherwise the variables
# stay empty so output is plain text. Each capability is guarded on its own
# because a terminal like TERM=dumb passes 'tput colors' but lacks sgr0/setaf,
# and a failure here would abort any set -e script that sources this file.
cNo='' cRed='' cGreen='' cYellow='' cBlue='' cMagenta='' cCyan='' cWhite=''
if tput colors >/dev/null 2>&1
then
  cNo=$(tput sgr0 2>/dev/null || true)
  cRed=$(tput setaf 1 2>/dev/null || true)
  cGreen=$(tput setaf 2 2>/dev/null || true)
  cYellow=$(tput setaf 3 2>/dev/null || true)
  cBlue=$(tput setaf 4 2>/dev/null || true)
  # part of the colour palette for sourcing scripts
  # shellcheck disable=SC2034
  cMagenta=$(tput setaf 5 2>/dev/null || true)
  cCyan=$(tput setaf 6 2>/dev/null || true)
  # part of the colour palette for sourcing scripts
  # shellcheck disable=SC2034
  cWhite=$(tput setaf 7 2>/dev/null || true)
fi

inArray () {
  local e
  for e in "${@:2}"; do [[ "$e" == "$1" ]] && return 0; done
  return 1
}

# prints a header block
print_block () {
  local i="$1" ; size=${#i}
  ((size+=2))
  printf "\n$cCyan"
  printf "%0.s*" $(seq 1 $size)
  printf "\n $cBlue$1\n$cCyan"
  printf "%0.s*" $(seq 1 $size)
  printf "$cNo\n\n"
}

# print rainbows and unicorns
print_fancy () {
  local font=${2}
  printf "$cGreen"
  if command -v figlet &> /dev/null; then
    figlet -f ${font:=$(printf "small")} ${1}
  else
    print_block "${1}"
  fi
  
  printf "$cNo\n"
}

# prints a closing block
print_block_end () {
  if [ ! -z "$1" ];then
    printf "\n$cBlue$1\n"
  fi
  printf "\n$cCyan"
  printf "%0.s*" $(seq 1 $size)
  printf "$cNo\n"
}

# pretty line output
print_line () {
  printf "$1$cGreen $2$cNo$3\n"
}

# pretty warning
print_warning () {
  printf "\n${cRed}Warning: ${cYellow}${1}${cNo}\n"
}

# print task header
print_task () {
  printf "\n$1 $cGreen$2$cNo\n"
}

# pretty error output
print_error () {
  printf "$cRed$1 $cYellow$2$cNo\n"
}

# echo each item of array on new line
print_array () {
  for item in "${@:1}"; do
    echo $item
  done
}

# Removes items from array
filter_array () {
  local filtered_array=()
  local filter=$1
  local exclude=$2

  for item in "${@:3}"; do
    grep -q $filter <<<$item
    if [ $? -eq $exclude ]; then
      filtered_array+=("$item")
    fi
  done

  echo "${filtered_array[@]}"
}

# Removes items from array which do NOT contain substring when exclude is true
filter_array_include () {
  filter_array "${1}" 0 "${@:2}"
}

# Removes items from array which contain substring when exclude is false
filter_array_exclude () {
  filter_array "${1}" 1 "${@:2}"
}

# check if a command exists
command_exists () {
  type "$1" &> /dev/null ;
}

info () {
  printf "  [ \033[00;34m..\033[0m ] $1"
}

user () {
  printf "\r  [ \033[0;33m?\033[0m ] $1 "
}

print_success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

print_fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit
}

uncomment () {
  sudo sed -ie "s|#${1}|${1}|g" "$2"
}

# outputs debug if $verbose is truthy
verboseOut () {
  if [ "${verbose:-}" = true ]; then
    echo $1 $cYellow$2 $cNo
  fi
}

cask_install() {
  print_task "Installing" "${@}"
  brew install --cask "${@}"
}

cask_reinstall() {
  print_task "Installing" "${@}" "(with force)"
  brew install --cask --force "${@}"
}

# source a file, but only if it exists
source_file() {
  if [[ -a $1 ]]; then
    # shellcheck source=src.sh
    source $1
    verboseOut "sourced: ${1}"
  fi
}

# source array of files, but only if it exists
source_files() {
  for file in "${@:1}"; do
    source_file $file
  done
}

# Finds $HOME (depth 1) and $HOME/.config (depth 1) symlinks whose target
# resolves under $DOTFILES but no longer exists on disk — the residue left
# behind when a topic is deleted but its already-created $HOME link isn't.
# Dry-run by default (lists only); pass "true" to actually remove them.
prune_dead_links () {
  local yes="${1:-false}"
  local -a dangling=()
  local link target

  while IFS= read -r -d '' link
  do
    target=$(readlink "$link")
    case "$target" in
      "$DOTFILES"/*)
        [ -e "$target" ] || dangling+=("$link")
        ;;
    esac
  done < <(
    find "$HOME" -maxdepth 1 -type l -print0 2>/dev/null
    find "$HOME/.config" -maxdepth 1 -type l -print0 2>/dev/null
  )

  if [ ${#dangling[@]} -eq 0 ]
  then
    print_success "no dangling \$DOTFILES symlinks found"
    return 0
  fi

  echo "Found ${#dangling[@]} dangling \$DOTFILES symlink(s):"
  for link in "${dangling[@]}"
  do
    echo "  $link -> $(readlink "$link")"
  done

  if [ "$yes" == "true" ]
  then
    for link in "${dangling[@]}"
    do
      rm "$link"
      print_success "removed $link"
    done
  else
    echo
    echo "Dry run only — nothing deleted. Re-run with 'dot symlink --prune --yes' to remove the above."
  fi
}

# Maps a *.symlink file under $DOTFILES_TOPIC_ROOT to its $HOME destination.
# Shared by bootstrap (linking) and unlink_dotfiles (reversing).
symlink_destination () {
  # Path within the topic, e.g. "zshrc.symlink" or ".config/topgrade.toml.symlink"
  local rel="${1#"$DOTFILES_TOPIC_ROOT"/}"
  rel="${rel#*/}"
  rel="${rel%.symlink}"

  if [[ "$rel" == */* ]]
  then
    # Nested paths keep their structure relative to $HOME (e.g. ~/.config/...)
    echo "$HOME/$rel"
  else
    echo "$HOME/.$rel"
  fi
}

# Prints the newest ~/.dotfiles_backup/<ts>/ copy of the given target's
# basename (bootstrap's backup() moves files in by basename), or nothing.
newest_backup_for () {
  local name ts
  name=$(basename "$1")
  while IFS= read -r ts
  do
    if [ -e "$HOME/.dotfiles_backup/$ts/$name" ] || [ -L "$HOME/.dotfiles_backup/$ts/$name" ]
    then
      echo "$HOME/.dotfiles_backup/$ts/$name"
      return 0
    fi
  done < <(ls -1 "$HOME/.dotfiles_backup" 2>/dev/null | sort -rn)
  return 0
}

# Reverses bootstrap: removes every $HOME link created from the *.symlink
# mapping whose target sits inside $DOTFILES. Anything else at the destination
# is left alone. Pass "true" to first copy back the newest backup of each.
unlink_dotfiles () {
  local restore="${1:-false}"
  local src dst target backup repo failed=0

  # Compare canonical paths, so relative links, a trailing slash on $DOTFILES
  # and symlinked directories inside the repo are all judged by where the link
  # finally lands
  repo=$(realpath "$DOTFILES") || return 1

  while IFS= read -r -d '' src
  do
    dst=$(symlink_destination "$src")
    [ -L "$dst" ] || continue
    target=$(realpath "$dst" 2>/dev/null) || continue
    case "$target" in
      "$repo"/*) ;;
      *) continue ;;
    esac

    # If the link survives, cp below would follow it and overwrite the repo file
    if ! rm "$dst" || [ -L "$dst" ]
    then
      print_error "could not remove $dst, skipped"
      failed=1
      continue
    fi
    print_success "removed $dst"

    if [ "$restore" == "true" ]
    then
      backup=$(newest_backup_for "$dst")
      if [ -z "$backup" ]
      then
        echo "  no backup found for $dst, left removed"
      elif cp -R "$backup" "$dst"
      then
        print_success "restored $dst from $backup"
      else
        print_error "could not restore $dst from $backup"
        failed=1
      fi
    fi
  done < <(find "$DOTFILES_TOPIC_ROOT" -name '*.symlink' -prune -print0)

  return "$failed"
}
