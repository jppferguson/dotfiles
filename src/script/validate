#!/usr/bin/env bash
#
# Run every dotfiles check: secrets, shellcheck, zsh syntax, markdown and the test suite.
# Pass check names to run a subset, e.g. `validate shellcheck zsh`.
#
###############################################################################

cd "$(dirname "${BASH_SOURCE[0]}")/../.." || exit 1

check_secrets () {
  # Full history, not just the tree: a secret removed in a later commit is still published
  gitleaks git --no-banner --redact .
}

check_shellcheck () {
  local scripts=() script
  # Left out because shellcheck cannot parse them: src/bin/git-wtf (Ruby),
  # src/functions/_brew (zsh completion) and src/functions/extract (zsh
  # autoload function). prezto is excluded except update.sh, whose zsh shebang
  # is overridden by a shellcheck shell=bash directive.
  while IFS= read -r script
  do
    scripts+=("$script")
  done < <(
    find src/bin -type f ! -name git-wtf
    find src/topics -name 'aliases.sh' -o -name 'install.sh' -o -name 'update.sh' -o -name 'set-*.sh' | grep -v prezto
  )
  shellcheck --severity=warning \
    src/script/bootstrap src/script/install src/script/update \
    src/script/init src/script/test src/script/test-dev src/script/validate \
    .githooks/pre-commit \
    src/functions/general src/functions/common \
    "${scripts[@]}" \
    src/topics/prezto/update.sh
}

check_zsh () {
  local failed=0 file
  while IFS= read -r -d '' file
  do
    zsh -n "$file" || failed=1
  done < <(find src/topics \( -name '*.zsh' -o -name 'z*.symlink' \) -type f -print0)
  return "$failed"
}

check_markdown () {
  # Tracked files only, so untracked scratch notes never fail the check;
  # vendored and generated paths are excluded in .markdownlint-cli2.jsonc
  git ls-files -z '*.md' | xargs -0 markdownlint-cli2
}

check_test () {
  bats test/*.bats
}

checks=("$@")
[ ${#checks[@]} -eq 0 ] && checks=(secrets shellcheck zsh markdown test)

failed=()
for check in "${checks[@]}"
do
  echo "==> $check"
  "check_$check" || failed+=("$check")
done

if [ ${#failed[@]} -gt 0 ]
then
  echo "Failed: ${failed[*]}"
  exit 1
fi
echo "All checks passed"
