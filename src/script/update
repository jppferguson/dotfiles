#!/usr/bin/env bash
#
# Update all the things (or just 1-or-2)
set -e

# Initialize dotfiles environment
. "$(dirname "$0")/init"

# Include the general functions
. $DOTFILES/src/functions/general

if [ "$1" = "" ] ; then
  print_block "Updating All The Things"
fi

# Update dotfiles to latest version
print_line "Making sure dotfiles are up-to-date first..."
cd "$DOTFILES" && git pull --ff-only

# find the update.sh files and run them iteratively
if [ "$1" = "" ] ; then
  updates=()
  while IFS= read -r update_script; do
    updates+=("$update_script")
  done < <(find . -name update.sh)
else
  updates=()
  for search in "${@}"; do
    while IFS= read -r update_script; do
      updates+=("$update_script")
    done < <(find . -name update.sh -path "*${search}*")
  done
fi

# Loop through update.sh files and execute them
for update in "${updates[@]}"; do
  bash "${update}"
done
