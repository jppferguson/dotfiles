#!/usr/bin/env bash
#
# Bootstrap installs things.
#
###############################################################################

# An unset, empty or literal "~" HOME would make BACKUP_DIR (and every link
# target) relative, creating a stray ./~ directory in the current directory
if [[ "${HOME:-}" != /* || ! -d "$HOME" ]]
then
  echo "HOME is not a valid absolute directory: '${HOME:-}'" >&2
  exit 1
fi

# Initialize dotfiles environment
. "$(dirname "${BASH_SOURCE[0]}")/init"

DOTFILES_TOPIC_ROOT=$(pwd)/src/topics
CUR_UNIX="$(date +%s)"
BACKUP_DIR="$HOME/.dotfiles_backup/${CUR_UNIX}/"

set -e

# Include the general functions
. $DOTFILES/src/functions/general


create_localrc () {
  LOCALRC=~/.localrc
  if [ -f "$LOCALRC" ]
  then
    print_success "skipped $LOCALRC (already exists)"
  else
    touch "$LOCALRC"
    print_success "created $LOCALRC"
  fi
}

backup () {
  mkdir -p "$BACKUP_DIR"
  mv "$1" "$BACKUP_DIR"
  print_success "backed up $1"
}

# Identity and credential helper are per machine, so they live in a small
# ~/.gitconfig.local that the tracked gitconfig.symlink includes
setup_gitconfig () {
  local gitconfig_local=~/.gitconfig.local

  if ! [ -f "$gitconfig_local" ]
  then
    info 'setup gitconfig'

    git_credential='cache'
    if [ "$(uname -s)" == "Darwin" ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your full name (used for git commits)?'
    read -e git_authorname
    user ' - What email do you want to use for git commits?'
    read -e git_authoremail

    git config --file "$gitconfig_local" user.name "$git_authorname"
    git config --file "$gitconfig_local" user.email "$git_authoremail"
    git config --file "$gitconfig_local" credential.helper "$git_credential"

    print_success "gitconfig ($gitconfig_local)"
  fi
}

# Brings a machine set up before the global hooks existed in line: the old
# repo-local core.hooksPath=.githooks would override the global one and now
# points at a deleted directory, leaving this repo with no secret scan.
migrate_git_hooks () {
  local gitconfig="$1" repo="$2"

  if [ -f "$gitconfig" ] && ! git config --file "$gitconfig" --get core.hooksPath > /dev/null
  then
    # Literal ~, which git expands itself, to match gitconfig.symlink
    # shellcheck disable=SC2088
    git config --file "$gitconfig" core.hooksPath '~/.dotfiles/src/topics/git/hooks'
    print_success "enabled the global git hooks in $gitconfig"
  fi

  if [ "$(git -C "$repo" config --local --get core.hooksPath)" == ".githooks" ]
  then
    git -C "$repo" config --local --unset core.hooksPath
    print_success "removed the old .githooks hooksPath from $repo"
  fi
}


link_file () {
  local src=$1 dst=$2

  local overwrite='' backup='' skip=''
  local action=

  if [ -L "$dst" ] && [ "$(readlink "$dst")" == "$src" ]
  then
    print_success "already linked $dst"
    return
  fi

  if [ -f "$dst" ] || [ -d "$dst" ] || [ -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then
      user "File already exists: $(basename "$src"), what do you want to do? [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
      read -n 1 action

      case "$action" in
        o )
          overwrite=true;;
        O )
          overwrite_all=true;;
        b )
          backup=true;;
        B )
          backup_all=true;;
        s )
          skip=true;;
        S )
          skip_all=true;;
        * )
          ;;
      esac
    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      print_success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      # mv "$dst" "${dst}.backup"
      # print_success "moved $dst to ${dst}.backup"
      backup "$dst"
    fi

    if [ "$skip" == "true" ]
    then
      print_success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    print_success "linked $1 to $2"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  # Read the file list on fd 3 so link_file's prompt still reads from stdin
  while IFS= read -r -d '' src <&3
  do
    local dst
    dst=$(symlink_destination "$src")
    mkdir -p "$(dirname "$dst")"
    link_file "$src" "$dst"
  done 3< <(find "$DOTFILES_TOPIC_ROOT" -name '*.symlink' -prune -print0)
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
  PRUNE=false
  PRUNE_YES=false
  for arg in "$@"
  do
    case "$arg" in
      --prune) PRUNE=true ;;
      --yes) PRUNE_YES=true ;;
    esac
  done

  if [ "$PRUNE" == "true" ]
  then
    prune_dead_links "$PRUNE_YES"
    exit 0
  fi

  create_localrc
  setup_gitconfig
  migrate_git_hooks src/topics/git/gitconfig.symlink "$DOTFILES"
  install_dotfiles
fi
