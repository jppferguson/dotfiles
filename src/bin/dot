#!/usr/bin/env bash
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

# Non-interactive shells (e.g. ssh host 'dot ...') never load zshrc, so derive
# the repo root from this script's own location. An exported DOTFILES wins.
if [ -z "$DOTFILES" ]
then
  dot_source="${BASH_SOURCE[0]}"
  while [ -L "$dot_source" ]
  do
    dot_link=$(readlink "$dot_source")
    case "$dot_link" in
      /*) dot_source="$dot_link" ;;
      *)  dot_source="$(dirname "$dot_source")/$dot_link" ;;
    esac
  done
  DOTFILES=$(cd "$(dirname "$dot_source")/../.." && pwd)
  export DOTFILES
  unset dot_source dot_link
fi

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1
SUB_COMMAND_NAME=$2

sub_help () {
  echo "Usage: $BIN_NAME <command>"
  echo
  echo "Commands:"
  echo "   cd               cd into dotfiles directory"
  echo "   clean            Clean up caches (brew)"
  echo "   claude {cmd}     Manage Claude configuration (install|status|diff|sync|backup)"
  echo "   dock             Apply macOS Dock settings"
  echo "   duti             Set default apps for file types (UTI)"
  echo "   edit             Open dotfiles in IDE ($EDITOR) and Git GUI ($GITGUI)"
  echo "   help             This help message"
  echo "   install {pkg}    Install a package"
  echo "   macos            Apply macOS system defaults"
  echo "   reload           Reload dotfiles"
  echo "   symlink          Symlink all dotfiles"
  echo "   symlink --prune [--yes]   List (or, with --yes, remove) dangling \$HOME symlinks left by deleted topics"
  echo "   test             Run tests"
  echo "   unlink [--restore]   Remove the \$HOME symlinks into the dotfiles (--restore copies back the newest ~/.dotfiles_backup file for each)"
  echo "   update           Update packages and pkg managers (brew, casks, cargo, pip3, npm, gems, macOS)"
  echo "   upgrade          Alias for update"
  echo "   validate {check} Run all checks, or only the named ones (secrets shellcheck zsh markdown test)"
}

sub_clean () {
  echo "$ brew cleanup"
  brew cleanup
  # echo "$ cargo cache --autoclean"
  # cargo cache --autoclean
  # echo "$ gem cleanup"
  # gem cleanup
  # echo "$ pip cache purge"
  # pip cache purge
}

sub_cd () {
  cd $DOTFILES && $SHELL
}

sub_claude () {
  case "${SUB_COMMAND_NAME:-install}" in
    "install")
      . "${DOTFILES}/src/topics/claude/install.sh"
      ;;
    "status"|"diff"|"sync"|"backup")
      . "${DOTFILES}/src/topics/claude/update.sh" "$SUB_COMMAND_NAME"
      ;;
    *)
      echo "Usage: $BIN_NAME claude {install|status|diff|sync|backup}"
      echo ""
      echo "  install  - Install/reinstall Claude configuration"
      echo "  status   - Show sync status"
      echo "  diff     - Show differences between dotfiles and ~/.claude"
      echo "  sync     - Sync dotfiles to ~/.claude (with backup)"
      echo "  backup   - Create manual backup of ~/.claude"
      ;;
  esac
}

sub_completion () {
  echo "cd clean claude dock duti edit help install macos reload symlink test unlink update upgrade validate"
}

sub_dock () {
  . "${DOTFILES}/src/topics/macos/set-dock.sh" && echo "Dock reloaded."
}

sub_duti () {
  . "${DOTFILES}/src/topics/duti/update.sh"
}

sub_edit () {
  sh -c "$EDITOR $DOTFILES"
  sh -c "$GITGUI $DOTFILES"
}

sub_install () {
  local SCRIPT="$DOTFILES/src/topics/$SUB_COMMAND_NAME/install.sh"
  if [ -f "$SCRIPT" ]; then
    # the topic script is chosen at runtime
    # shellcheck disable=SC1090
    . "$SCRIPT"
  else
    echo "Unable to find script to install $SUB_COMMAND_NAME" >&2
    exit 1
  fi
}

sub_macos () {
  . "${DOTFILES}/src/topics/macos/update.sh"
}

sub_reload () {
  exec $SHELL -l
}

sub_symlink () {
  $DOTFILES/src/script/bootstrap "$@"
}

sub_test () {
  bats "$DOTFILES"/test/*.bats
}

sub_validate () {
  "$DOTFILES"/src/script/validate "$@"
}

sub_unlink () {
  local restore=false
  case "${1:-}" in
    "") ;;
    --restore) restore=true ;;
    *) echo "Usage: $BIN_NAME unlink [--restore]" >&2; return 1 ;;
  esac
  . "$DOTFILES/src/functions/general"
  DOTFILES_TOPIC_ROOT="$DOTFILES/src/topics"
  unlink_dotfiles "$restore"
}

sub_update () {
  # Anything run with sudo that writes into Homebrew's prefix (e.g. `sudo gem`)
  # leaves root-owned files behind, and `brew cleanup` then fails on them
  local brew_prefix=/opt/homebrew
  if [ -d "$brew_prefix" ] && [ -n "$(find "$brew_prefix" ! -user "$USER" -print -quit 2>/dev/null)" ]; then
    echo "Fixing ownership of files under $brew_prefix not owned by $USER"
    sudo find "$brew_prefix" ! -user "$USER" -exec chown -h "$USER":admin {} +
  fi

  # Global npm/corepack installs don't regenerate asdf shims, so topgrade's
  # `pnpm update -g` fails with "No version is set" until they are rebuilt
  command -v asdf > /dev/null && asdf reshim
  topgrade
}

sub_upgrade () {
  sub_update
}

case $COMMAND_NAME in
  "" | "-h" | "--help")
    sub_help
    ;;
  *)
    shift
    if ! declare -f "sub_${COMMAND_NAME}" > /dev/null; then
      echo "'$COMMAND_NAME' is not a known command." >&2
      sub_help
      exit 1
    fi
    "sub_${COMMAND_NAME}" "$@"
    ;;
esac
