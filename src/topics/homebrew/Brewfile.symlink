tap 'homebrew/services'
tap 'dsully/tap'
brew "dsully/tap/macos-defaults"

# Allow installing from Mac App Store
brew "mas"

# System tools
brew 'bats-core'
brew 'coreutils'
brew 'dockutil'
brew 'duti'
brew 'gitleaks'
brew 'jq'
brew 'markdownlint-cli2'
brew 'shellcheck'
brew 'topgrade'

# Package management
brew 'asdf'
# asdf Pythons link against it for hashlib's blake2; without it listed here
# `brew autoremove` drops it and pip logs blake2b/blake2s errors
brew 'libb2'

# Other stuff
brew 'ffmpeg'
brew 'figlet'
brew 'gifsicle'
brew 'git-extras'
brew 'grc'
brew 'spark'

# Communication
cask 'slack'
mas "WhatsApp", id: 1147396723
cask 'zoom'

# Cloud
cask 'dropbox'
cask 'google-drive'

# Media
# cask 'amazon-music' # Doesnt work on M1 Macs
cask 'spotify'
cask 'vlc'

# Productivity
cask '1password'
cask 'alfred'
cask 'evernote'
cask 'notion'
cask 'notion-calendar'
mas 'Things 3', id: 904280696
mas 'Toggl Track', id: 1291898086

# System
cask 'hammerspoon'

# Dev
brew 'gh'
cask 'android-studio'
cask 'docker'
cask 'elgato-stream-deck'
cask 'iterm2'
cask 'kaleidoscope'
cask 'local'
cask 'postman'
cask 'proxyman'
cask 'sourcetree'
cask 'transmit'
cask 'visual-studio-code'
mas "Xcode", id: 497799835

# Design
cask 'figma'
cask 'rightfont'

# Fonts
cask 'font-fira-code'
cask 'font-fira-mono-for-powerline'
cask 'font-inconsolata-for-powerline'
cask 'font-inconsolata-nerd-font'
cask 'font-open-sans'
cask 'font-source-code-pro'

# Browsers
cask 'firefox'
cask 'firefox@developer-edition'
cask 'google-chrome'
cask 'google-chrome@canary'
cask 'opera'

# Utilities
cask 'the-unarchiver'

# Mac Apps
mas "Keynote", id: 409183694
mas "Numbers", id: 409203825
mas "Pages", id: 409201541