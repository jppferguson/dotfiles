#!/usr/bin/env bash
#
# Global git hook, reached through core.hooksPath. Every hook name in this
# directory is a symlink to this script. pre-commit scans the staged changes
# with gitleaks (bypass a false positive with `git commit --no-verify` and add
# its fingerprint to .gitleaksignore). It then hands off to the repo's own hook
# of the same name, because a global core.hooksPath stops git running
# .git/hooks. Repos that set their own core.hooksPath (husky) bypass this.
#
###############################################################################

set -u

hook_name=$(basename "$0")

if [ "$hook_name" = "pre-commit" ]
then
  # Fail closed: a missing scanner must not quietly let a secret through
  if ! command -v gitleaks > /dev/null 2>&1
  then
    echo "gitleaks not found on PATH, so the secret scan cannot run." >&2
    echo "Install it with 'brew install gitleaks', or commit with --no-verify to skip the scan once." >&2
    exit 1
  fi
  gitleaks git --pre-commit --staged --no-banner --redact || exit $?
fi

repo_hooks_dir=$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null)/hooks
repo_hook="$repo_hooks_dir/$hook_name"

# A repo hook that is itself a link to this script would exec it forever
if [ -x "$repo_hook" ] && [ ! -d "$repo_hook" ] &&
  [ "$(realpath "$repo_hook")" != "$(realpath "$0")" ]
then
  exec "$repo_hook" "$@"
fi
