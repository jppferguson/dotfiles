# Help: `topgrade --config-reference` (displays https://github.com/topgrade-rs/topgrade/blob/main/config.example.toml)
#
# This IS the canonical config — it must stay symlinked to $HOME/.config/topgrade.toml
# by `dot symlink`. Nothing prevents it being a symlink; it drifted to a plain,
# effectively-empty file at that path (audit-2026-09) because bootstrap's
# nested-path (.config/...) linking hit a pre-existing file there and never
# resolved the conflict. Confirmed via `topgrade --dry-run -v` debug logs
# (topgrade 17.9.0) that config is loaded ONLY from $XDG_CONFIG_HOME/topgrade.toml
# — the legacy `~/.topgrade.toml` path is not read at all, so a symlink there is
# dead weight. Do not recreate it.

[misc]
assume_yes = true
# pnpm: the asdf shim runs an older npm-installed pnpm whose global bin dir
# differs from Homebrew's, and nothing is installed globally with pnpm anyway
# opencode, uv: installed and updated by Homebrew; topgrade can't parse
# `opencode -v` and the uv step blocks on the cache lock held by long-running
# uvx MCP servers, with no uv tools or managed Pythons to upgrade
disable = ["node", "pnpm", "opencode", "uv"]
display_time = false
cleanup = true
pre_sudo = true
sudo_loop = true
# softwareupdate prompts for the volume owner password regardless of sudo
last = ["system"]

[commands]
"npm" = "npm update --location global --force"
# Report-only drift check against vs-code/extensions.txt: never installs or
# removes anything (topgrade's own vscode step handles upgrades)
"VS Code extensions" = 'DOTFILES="${DOTFILES:-$HOME/.dotfiles}" bash "${DOTFILES:-$HOME/.dotfiles}/src/topics/vs-code/update.sh"'

[post_commands]
# The gems step installs new versions alongside old ones, and the leftovers
# trigger "Unresolved or ambiguous specs" warnings on later runs
"Gem cleanup" = "gem cleanup"

[git]
repos = ["~/.dotfiles"]
pull_predefined = false

[containers]
# Locally built image, nothing to pull from a registry
ignored_containers = ["hermes-agent*"]
