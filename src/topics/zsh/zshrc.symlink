#!/bin/bash

# uncomment for debugging:
# export profiling=true     # profile zsh startup
# export verbose=true       # more verbose output

# start profiling if enabled
if [ "$profiling" = true ]; then
  zmodload zsh/zprof
fi

# add default $DOTFILES
if [[ ! $DOTFILES ]]
then
  DOTFILES="${HOME}/.dotfiles/"
fi
# shellcheck source=$DOTFILES/src/functions/general
. $DOTFILES/src/functions/common
. $DOTFILES/src/functions/general

# use .localrc for SUPER SECRET CRAP that you don't # want in your public, versioned repo.
source_file ~/.localrc

# using .commonrc for stuff you want shared between zsh and bash
source_file ~/.commonrc

# all of our zsh files
typeset -U config_files
config_files=($DOTFILES/src/topics/**/*.zsh)

# load the path files
source_files ${(M)config_files:#*/path.zsh}

# path.zsh files load in alphabetical topic order, so homebrew/path.zsh
# (prepending /opt/homebrew/bin) runs after asdf/path.zsh and shadows asdf's
# shims for anything also installed via brew (e.g. node). Re-assert asdf's
# shims at the front so version-managed tools always win over brew's.
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

# load everything but the path and completion files
source_files ${config_files:#*/(path|completion).zsh}

# prezto's completion module runs compinit; only fall back if it didn't load
# (e.g. fresh machine before prezto is installed)
whence compdef > /dev/null || { autoload -U compinit && compinit -i }

# load every completion after autocomplete loads
source_files ${(M)config_files:#*/completion.zsh}

# include bash aliases & functions
loadAllAliases
source_file ~/.aliases
source_file ~/.functions

# end profiling if profiling is enabled
if [ "$profiling" = true ]; then
  zprof
fi

# cleanup variables
unset config_files verbose profiling

